# 复制为 .env 并填写实际值（.env 不提交 git）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=library_app
DB_PASSWORD=改个强密码
DB_NAME=library_seat

# 后台登录态 JWT 密钥，务必设为足够长的随机字符串
JWT_SECRET=请改成一段随机长字符串
JWT_EXPIRE_HOURS=24

# 仅首次启动播种用，之后以数据库为准
LICENSE_KEY=旧key原样

# 首次启动创建管理员（admins 表为空时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=管理员的强密码

# 可选：旧版 /logs 简单页面查看密钥（不设则开放）
LOG_VIEW_KEY=
